{
  "manifest_version": 3,
  "name": "YouTube Buddy (Shared)",
  "version": "0.1.0",
  "description": "Passively share YouTube watch progress with a Buddy via a Friend Code.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://youtube-buddy-stable.aidanchien18-a8d.workers.dev/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["shared.js", "reporter.js", "renderer.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
