{
	"manifest_version": 3,
	"name": "YouTube Buddy",
	"version": "0.1.0",
	"description": "Passively share YouTube watch progress with a Buddy via a Room Code.",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"permissions": ["storage"],
	"host_permissions": ["*://*.youtube.com/*", "http://localhost:8787/*"],
	"action": {
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png",
			"48": "icons/icon-48.png",
			"128": "icons/icon-128.png"
		},
		"default_popup": "popup/popup.html"
	},
	"content_scripts": [
		{
			"matches": ["*://*.youtube.com/*"],
			"js": [
				"content/shared.js",
				"content/shared-api.js",
				"content/shared-notes.js",
				"content/shared-geometry.js",
				"content/shared-room.js",
				"content/shared-buddies.js",
				"content/theme.js",
				"content/room-code.js",
				"content/mentions.js",
				"content/reporter.js",
				"content/renderer.js",
				"content/notes.js",
				"content/presence.js",
				"content/composer.js",
				"content/home-section.js",
				"content/home-toggle.js",
				"content/playlist-add.js",
				"content/content.js"
			],
			"run_at": "document_idle"
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["pages/control-panel-relay.html", "pages/control-panel-relay.js"],
			"matches": ["*://*.youtube.com/*"]
		}
	]
}
