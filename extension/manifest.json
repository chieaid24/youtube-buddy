{
	"manifest_version": 3,
	"name": "YouTube Buddy",
	"version": "0.1.0",
	"description": "Passively share YouTube watch progress with a Buddy via a Room Code.",
	"permissions": ["storage"],
	"host_permissions": ["*://*.youtube.com/*", "http://localhost:8787/*"],
	"action": {
		"default_popup": "popup.html"
	},
	"content_scripts": [
		{
			"matches": ["*://*.youtube.com/*"],
			"js": [
				"shared.js",
				"theme.js",
				"room-code.js",
				"mentions.js",
				"reporter.js",
				"renderer.js",
				"notes.js",
				"presence.js",
				"composer.js",
				"home-section.js",
				"home-toggle.js",
				"playlist-add.js",
				"content.js"
			],
			"run_at": "document_idle"
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["popup.html", "shared.js", "theme.js", "room-code.js", "popup.js"],
			"matches": ["*://*.youtube.com/*"]
		}
	]
}
