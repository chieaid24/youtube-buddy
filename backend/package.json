{
	"name": "backend",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"render:icons": "node scripts/render-extension-icons.mjs",
		"check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p test/e2e/tsconfig.json && prettier --config .prettierrc --ignore-unknown --check 'src/**' 'scripts/**' 'test/**' '../extension/**'",
		"test": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:live": "YTB_LIVE_YOUTUBE=1 playwright test --grep @live",
		"cf-typegen": "wrangler types",
		"prepare": "cd .. && husky backend/.husky"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.18.7",
		"@playwright/test": "^1.61.1",
		"@types/chrome": "^0.2.2",
		"@types/node": "^25.9.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"prettier": "^3.9.4",
		"typescript": "^5.5.2",
		"vitest": "^4.1.9",
		"wrangler": "^4.113.0"
	},
	"overrides": {
		"sharp": "^0.35.3"
	}
}
